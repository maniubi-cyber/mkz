# 复制为 .env 后填写
# cp .env.example .env

# ============ LLM（必填，RAG 问答依赖） ============
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL_NAME=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# ============ 应用安全 ============
# 必改：JWT 签名密钥（≥32 字符）
JWT_SECRET=please-change-me-to-a-random-256-bit-secret
# 必改：Java <-> Python 内部调用签名（两侧一致）
AI_INTERNAL_SECRET=please-change-me

# ============ 基础设施凭证 ============
MYSQL_ROOT_PASSWORD=Root@2024Secure
REDIS_PASSWORD=Redis@2024Secure
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
