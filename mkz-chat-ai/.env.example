# ===== LLM (Ollama OpenAI 兼容接口) =====
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen3:0.6b
LLM_TEMPERATURE=0.4
LLM_STREAM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=3
# 摘要压缩专用模型(可用更小模型降低开销)
LLM_SUMMARY_MODEL=qwen3:0.6b

# ===== Redis =====
REDIS_HOST=192.168.150.101
REDIS_PORT=6379
REDIS_PASSWORD=123321
REDIS_DB=0

# ===== Chroma 向量库 =====
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=ai-chat

# ===== 记忆管理 =====
MEMORY_WINDOW_SIZE=10
MEMORY_SUMMARY_THRESHOLD=20
MEMORY_CHECKPOINT_INTERVAL=5
MEMORY_SUMMARY_TTL_DAYS=7
MEMORY_CHECKPOINT_TTL_DAYS=30

# ===== HITL 审批 =====
APPROVAL_TIMEOUT_SECONDS=300
APPROVAL_TTL_HOURS=24

# ===== Java 业务服务网关 =====
