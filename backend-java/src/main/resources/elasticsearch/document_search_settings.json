{
  "index": {
    "number_of_shards": 3,
    "number_of_replicas": 1,
    "max_result_window": 10000
  },
  "analysis": {
    "analyzer": {
      "ik_max_word": {
        "type": "custom",
        "tokenizer": "ik_max_word",
        "filter": ["lowercase", "asciifolding"]
      },
      "ik_smart": {
        "type": "custom",
        "tokenizer": "ik_smart",
        "filter": ["lowercase", "asciifolding"]
      },
      "ik_search_analyzer": {
        "type": "custom",
        "tokenizer": "ik_smart",
        "filter": ["lowercase", "asciifolding", "synonym_filter"]
      }
    },
    "filter": {
      "synonym_filter": {
        "type": "synonym",
        "synonyms_path": "analysis/synonyms.txt",
        "updateable": true
      }
    }
  }
}
